<!DOCTYPE html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Report Card Comment Converter</title>
<style>
:root{--bg:#f6f5f1;--card:#fff;--ink:#222;--mute:#6b6b66;--line:#dcdad2;--accent:#2f6f5e;--accent-ink:#fff;
--c:#d6f0de;--k:#ffe7a8;--w:#ffcfcf}
@media (prefers-color-scheme:dark){:root{--bg:#161715;--card:#202220;--ink:#ecebe6;--mute:#9a9a92;--line:#34362f;--accent:#5fb89f;--accent-ink:#0f1a16;
--c:#23473a;--k:#5a4a14;--w:#5c2626}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;padding:20px 14px 60px}
main{max-width:780px;margin:0 auto}
h1{font-size:22px;margin:0 0 4px}
.sub{color:var(--mute);margin:0 0 18px;font-size:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:14px}
label{display:block;font-weight:600;font-size:14px;margin-bottom:6px}
.hint{font-weight:400;color:var(--mute)}
input[type=text],textarea{width:100%;font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:8px;padding:9px 10px}
textarea{min-height:150px;resize:vertical}
input:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:1px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}
button{font:inherit;font-size:14px;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:8px;padding:7px 13px;cursor:pointer}
button:hover{border-color:var(--accent)}
button.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:600}
button.small{padding:3px 9px;font-size:13px}
button.danger:hover{border-color:#c0392b;color:#c0392b}
.out{white-space:pre-wrap;word-wrap:break-word;border:1px solid var(--line);border-radius:8px;padding:10px;min-height:60px}
.out .c{background:var(--c);border-radius:4px;padding:0 2px}
.out .k{background:var(--k);border-radius:4px;padding:0 2px}
.out .w{background:var(--w);border-radius:4px;padding:0 2px}
.legend{font-size:12px;color:var(--mute);margin-top:8px}
.legend span{border-radius:4px;padding:0 5px;margin-right:6px;color:var(--ink)}
.status{font-size:14px;margin:8px 0 0;color:var(--mute)}
.checks{margin:10px 0 0;padding:0;list-style:none;font-size:14px}
.checks li{padding:3px 0}
.checks li::before{content:"\26A0\FE0F  "}
.ok{color:var(--accent);font-size:14px;margin-top:10px}
.prev p{margin:6px 0;font-size:14px}
.prev b{color:var(--mute);font-weight:600}
.hist-head{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.hist-head h2{font-size:17px;margin:0}
.item{border-top:1px solid var(--line);padding:10px 0}
.item:first-of-type{margin-top:10px}
.meta{font-size:12px;color:var(--mute);display:flex;gap:8px;align-items:center;margin-bottom:4px}
.snip{font-size:14px;white-space:pre-wrap;word-wrap:break-word}
.empty{color:var(--mute);font-size:14px;margin-top:10px}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:8px 16px;border-radius:20px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.show{opacity:1}
.warnbar{background:var(--k);padding:8px 12px;border-radius:8px;font-size:13px;margin-bottom:14px;display:none}
</style>
</head>
<body>
<main>
<h1>Report Card Comment Converter</h1>
<p class="sub">Paste a comment with the real name and pronouns. Get back %Name, %he, %his, %him, %himself.</p>
<div class="warnbar" id="nostore">Saving is unavailable in this browser, so your draft and history will not survive a refresh.</div>

<div class="card">
  <label for="name">Student's name <span class="hint">as written in the comment (add a nickname with a comma)</span></label>
  <input type="text" id="name" autocomplete="off" placeholder="e.g. Amina">
  <label for="inp" style="margin-top:14px">Comment</label>
  <textarea id="inp" spellcheck="true" lang="en-CA" placeholder="Paste or type the comment here..."></textarea>
  <div class="status" id="detected"></div>
  <ul class="checks" id="checks"></ul>
</div>

<div class="card">
  <label>Converted</label>
  <div class="out" id="out"></div>
  <div class="legend"><span style="background:var(--c)">converted</span><span style="background:var(--k)">check this one</span><span style="background:var(--w)">not converted</span></div>
  <div class="status" id="counts"></div>
  <div class="row">
    <button class="primary" id="copy">Copy result</button>
    <button id="save">Save to history</button>
    <button class="danger" id="clear">Clear</button>
  </div>
</div>

<div class="card prev">
  <label>How it will read in the system</label>
  <p><b>As a girl:</b> <span id="pg"></span></p>
  <p><b>As a boy:</b> <span id="pb"></span></p>
</div>

<div class="card">
  <div class="hist-head">
    <h2>History <span class="hint" id="hcount"></span></h2>
    <div class="row" style="margin:0">
      <label style="margin:0;font-weight:400;font-size:13px"><input type="checkbox" id="withdate"> include date</label>
      <button class="small" id="copyall">Copy all</button>
      <button class="small danger" id="clearhist">Clear history</button>
    </div>
  </div>
  <div id="hist"></div>
</div>
</main>
<div class="toast" id="toast"></div>

<script>
// CORE START
const FEM=new Set(['she','her','hers','herself']);
const MASC=new Set(['he','him','his','himself']);
const THEY=new Set(['they','them','their','theirs','themselves','themself']);
const OBJ_NEXT=new Set(['to','in','with','and','on','at','for','a','an','the','up','out','but','so','as','by','from','when','if','that','because','how','about','into','over','after','before','than','too','or','while','of','is','was','will','can','has','had','does','did','during','through','under','around','without','again','back','down','off','there','here','what','who','which','where','why','then','this','these','those','all','both','each','every','toward','towards','near','like','she','he','they','we','you','i','it','not','would','could','should','must','may','might','are','were','be','been']);
const esc=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
const cap=s=>s.charAt(0).toUpperCase()+s.slice(1);
const START_RE=/(?:^|[.!?]["”')\]]*\s+|\n\s*)["“‘'(\[]*$/;
function nameList(str){return (str||'').split(/[,;\n]/).map(s=>s.trim()).filter(Boolean).sort((a,b)=>b.length-a.length)}
function convert(text,nameStr){
  const names=nameList(nameStr);
  const re=names.length
    ? new RegExp('(?<![A-Za-z])('+names.map(esc).join('|')+')(?![A-Za-z])|[A-Za-z]+','gi')
    : /[A-Za-z]+/g;
  const segs=[];let last=0,m,fem=0,masc=0,they=0,nameHits=0,placeholders=0;
  while((m=re.exec(text))){
    const idx=m.index,w=m[0],lw=w.toLowerCase(),end=idx+w.length;
    if(idx>last)segs.push({t:text.slice(last,idx),k:'p'});
    last=end;
    if(idx>0&&text[idx-1]==='%'){segs.push({t:w,k:'p'});continue}
    const atStart=START_RE.test(text.slice(0,idx));
    const tok=base=>'%'+(atStart?cap(base):base);
    if(m[1]!==undefined){segs.push({t:'%Name',k:'c'});nameHits++;placeholders++;continue}
    if(lw==='she'||lw==='he'){(lw==='she'?fem++:masc++);segs.push({t:tok('he'),k:'c'});placeholders++}
    else if(lw==='him'){masc++;segs.push({t:tok('him'),k:'c'});placeholders++}
    else if(lw==='his'){masc++;segs.push({t:tok('his'),k:'c'});placeholders++}
    else if(lw==='himself'||lw==='herself'){(lw==='herself'?fem++:masc++);segs.push({t:tok('himself'),k:'c'});placeholders++}
    else if(lw==='hers'){fem++;segs.push({t:tok('his'),k:'k',n:'"hers" became %his - check it'});placeholders++}
    else if(lw==='her'){
      fem++;
      const after=text.slice(end);
      const nx=after.match(/^\s*([A-Za-z]+)/);
      const obj=/^\s*$|^\s*[.,;:!?)\]"”]/.test(after)||(nx&&OBJ_NEXT.has(nx[1].toLowerCase()));
      segs.push({t:tok(obj?'him':'his'),k:'k',n:'"her" guessed as '+(obj?'%him (object)':'%his (possessive)')});placeholders++;
    }
    else if(THEY.has(lw)){they++;segs.push({t:w,k:'w'})}
    else segs.push({t:w,k:'p'});
  }
  if(last<text.length)segs.push({t:text.slice(last),k:'p'});
  return {segs,out:segs.map(s=>s.t).join(''),fem,masc,they,nameHits,names,placeholders};
}
function checksFor(text,r){
  const c=[];
  if(r.names.length===0&&text.trim())c.push('No name entered, so the name was not converted.');
  else if(r.names.length&&text.trim()&&r.nameHits===0)c.push('The name "'+r.names[0]+'" was not found in the comment.');
  if(r.fem&&r.masc)c.push('The comment mixes she/her and he/him words. Possible copy-paste mistake.');
  if(r.they)c.push('Found they/them/their. These are not converted (the system only takes %he, %his, %him).');
  if(/ {2,}/.test(text))c.push('Double spaces found.');
  const rep=text.match(/\b([A-Za-z]+)\s+\1\b/i);
  if(rep)c.push('Repeated word: "'+rep[0]+'".');
  const sents=text.split(/(?<=[.!?])\s+/).filter(s=>s.trim());
  if(sents.some(s=>/^["'(]*[a-z]/.test(s.trim())))c.push('A sentence does not start with a capital letter.');
  if(text.trim()&&!/[.!?]["”')\]]*\s*$/.test(text))c.push('The comment does not end with a full stop.');
  return c;
}
const MAP={girl:{he:'she',his:'her',him:'her',himself:'herself'},boy:{he:'he',his:'his',him:'him',himself:'himself'}};
function preview(out,g,nm){
  return out.replace(/%(name|he|his|him|himself)(?![A-Za-z])/gi,(x,w)=>{
    const lw=w.toLowerCase(),up=w[0]===w[0].toUpperCase();
    const r=lw==='name'?nm:MAP[g][lw];
    return up?cap(r):r;
  });
}
// CORE END

const $=id=>document.getElementById(id);
const DKEY='rc_draft_v1',HKEY='rc_history_v1';
let storeOK=true;
function store(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){storeOK=false;$('nostore').style.display='block'}}
function load(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){storeOK=false;$('nostore').style.display='block';return d}}
const E=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
let hist=load(HKEY,[]);
let sel=new Set();
let cur=null;

function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.id);toast.id=setTimeout(()=>t.classList.remove('show'),1600)}
async function copyText(t){
  try{await navigator.clipboard.writeText(t);return true}catch(e){}
  const ta=document.createElement('textarea');ta.value=t;ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.select();
  let ok=false;try{ok=document.execCommand('copy')}catch(e){}ta.remove();return ok;
}
const stamp=ts=>new Date(ts).toLocaleString('en-CA',{dateStyle:'medium',timeStyle:'short'});

function update(){
  const text=$('inp').value,nm=$('name').value;
  store(DKEY,{name:nm,text});
  cur=convert(text,nm);
  $('out').innerHTML=text.trim()?cur.segs.map(s=>{
    const cls=s.k==='p'?'':' class="'+s.k+'"';
    const ttl=s.n?' title="'+E(s.n)+'"':'';
    return s.k==='p'?E(s.t):'<span'+cls+ttl+'>'+E(s.t)+'</span>';
  }).join(''):'<span style="color:var(--mute)">The converted comment appears here.</span>';
  let d='';
  if(text.trim()){
    if(cur.fem||cur.masc)d='Detected: '+(cur.fem>=cur.masc?'girl (she/her)':'boy (he/him)')+'. '+cur.placeholders+' placeholder'+(cur.placeholders===1?'':'s')+' inserted.';
    else d='No pronouns found.';
  }
  $('detected').textContent=d;
  const ch=checksFor(text,cur);
  $('checks').innerHTML=ch.map(x=>'<li>'+E(x)+'</li>').join('');
  const words=cur.out.trim()?cur.out.trim().split(/\s+/).length:0;
  $('counts').textContent=words+' words, '+cur.out.length+' characters';
  const first=cur.names[0]||'Sam';
  $('pg').textContent=text.trim()?preview(cur.out,'girl',first):'';
  $('pb').textContent=text.trim()?preview(cur.out,'boy',first):'';
}

function saveHist(){
  if(!cur||!$('inp').value.trim())return false;
  if(hist[0]&&hist[0].out===cur.out){hist[0].ts=Date.now();}
  else hist.unshift({id:Date.now()+''+Math.random().toString(36).slice(2,6),ts:Date.now(),name:$('name').value,text:$('inp').value,out:cur.out});
  hist=hist.slice(0,20);
  store(HKEY,hist);renderHist();return true;
}
function renderHist(){
  sel=new Set([...sel].filter(id=>hist.some(h=>h.id===id)));
  $('hcount').textContent=hist.length?'('+hist.length+' of 20)':'';
  $('hist').innerHTML=hist.length?hist.map(h=>
    '<div class="item" data-id="'+h.id+'"><div class="meta"><input type="checkbox" class="pick"'+(sel.has(h.id)?' checked':'')+'> <span>'+E(stamp(h.ts))+'</span>'+
    '<span style="flex:1"></span><button class="small load">Load</button><button class="small cp">Copy</button><button class="small danger del">Delete</button></div>'+
    '<div class="snip">'+E(h.out)+'</div></div>').join(''):'<div class="empty">Nothing saved yet. Copy a result or press Save to history.</div>';
  $('copyall').textContent=sel.size?'Copy selected ('+sel.size+')':'Copy all';
}
function histText(list){
  const inc=$('withdate').checked;
  return list.map(h=>(inc?stamp(h.ts)+'\n':'')+h.out).join('\n\n');
}

$('inp').addEventListener('input',update);
$('name').addEventListener('input',update);
$('copy').onclick=async()=>{
  if(!$('inp').value.trim()){toast('Nothing to copy');return}
  saveHist();
  toast(await copyText(cur.out)?'Copied and saved':'Copy blocked - select the text and copy it manually');
};
$('save').onclick=()=>{toast(saveHist()?'Saved to history':'Nothing to save')};
$('clear').onclick=()=>{$('inp').value='';$('name').value='';update();$('inp').focus()};
$('hist').addEventListener('click',async e=>{
  const item=e.target.closest('.item');if(!item)return;
  const h=hist.find(x=>x.id===item.dataset.id);if(!h)return;
  if(e.target.classList.contains('pick')){e.target.checked?sel.add(h.id):sel.delete(h.id);renderHist();return}
  if(e.target.classList.contains('load')){$('name').value=h.name;$('inp').value=h.text;update();window.scrollTo({top:0,behavior:'smooth'})}
  if(e.target.classList.contains('cp')){toast(await copyText($('withdate').checked?stamp(h.ts)+'\n'+h.out:h.out)?'Copied':'Copy blocked')}
  if(e.target.classList.contains('del')){hist=hist.filter(x=>x.id!==h.id);store(HKEY,hist);renderHist()}
});
$('copyall').onclick=async()=>{
  const list=sel.size?hist.filter(h=>sel.has(h.id)):hist;
  if(!list.length){toast('History is empty');return}
  toast(await copyText(histText(list))?'Copied '+list.length+' comment'+(list.length===1?'':'s'):'Copy blocked');
};
let armed=false;
$('clearhist').onclick=()=>{
  const b=$('clearhist');
  if(!armed){armed=true;b.textContent='Sure? Click again';setTimeout(()=>{armed=false;b.textContent='Clear history'},3000);return}
  armed=false;b.textContent='Clear history';hist=[];sel.clear();store(HKEY,hist);renderHist();
};

const d=load(DKEY,{name:'',text:''});
$('name').value=d.name||'';$('inp').value=d.text||'';
update();renderHist();
</script>
</body>
</html>
